# Azure OpenAI (for --llm gpt4)
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_BASE=https://YOUR_AZURE_ENDPOINT.openai.azure.com/
AZURE_OPENAI_ENGINE=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Ollama (for --llm llama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:latest

# Qwen / DashScope (for --llm qwen)
DASHSCOPE_API_KEY=your-dashscope-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
